NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school_management
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated allowed website URLs. In development any localhost / 127.0.0.1 port is accepted too.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Photo storage (recommended for albums with many photos). Create a free account at cloudinary.com, then either:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# or the three values below. Leave all empty to keep photos in MongoDB instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
